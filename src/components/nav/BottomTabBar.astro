---
interface Props {
  active?: string;
}

const { active = "projects" } = Astro.props;
---

<nav class="fixed bottom-0 left-0 right-0 border-t border-[var(--border)] bg-[var(--card)] safe-area-inset-bottom">
  <div class="flex items-center justify-around h-16">
    <a
      href="/"
      class:list={[
        "flex flex-col items-center justify-center w-16 h-14 text-xs",
        active === "home" 
          ? "text-[var(--accent)]" 
          : "text-[var(--text-muted)] hover:text-[var(--text)]"
      ]}
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
      </svg>
      <span class="mt-1">Projects</span>
    </a>
    
    <a
      href="/projects/new"
      class:list={[
        "flex flex-col items-center justify-center w-16 h-14 text-xs",
        active === "new" 
          ? "text-[var(--accent)]" 
          : "text-[var(--text-muted)] hover:text-[var(--text)]"
      ]}
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
      </svg>
      <span class="mt-1">New</span>
    </a>
  </div>
</nav>