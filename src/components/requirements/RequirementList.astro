---
interface Props {
  requirements: Array<{
    id: string;
    title: string;
    description: string | null;
    priority: string;
    status: string;
    createdAt: Date;
  }>;
}

const { requirements } = Astro.props;
---

{requirements.length === 0 ? null : (
  <ul class="space-y-2">
    {requirements.map((req) => (
      <li class="flex items-center justify-between gap-3 p-4 rounded-xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
        <div class="flex-1 min-w-0">
          <p class="font-medium text-zinc-900 dark:text-zinc-100 truncate">{req.title}</p>
          {req.description && (
            <p class="text-sm text-zinc-500 dark:text-zinc-400 mt-0.5 truncate">{req.description}</p>
          )}
        </div>
        <div class="flex items-center gap-2 flex-shrink-0">
          <span class:list={[
            "w-2 h-2 rounded-full",
            req.status === "done" ? "bg-emerald-500" :
            req.status === "in-progress" ? "bg-blue-500" :
            "bg-zinc-300 dark:bg-zinc-600"
          ]}></span>
        </div>
      </li>
    ))}
  </ul>
)}