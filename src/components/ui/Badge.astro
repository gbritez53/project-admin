---
interface Props {
  variant: "active" | "archived" | "draft" | "pending" | "in-progress" | "done" | "low" | "medium" | "high" | "critical";
}

const { variant } = Astro.props;

const badgeStyles: Record<string, string> = {
  active: "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/50 dark:text-emerald-400",
  archived: "bg-zinc-100 text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400",
  draft: "bg-amber-100 text-amber-700 dark:bg-amber-900/50 dark:text-amber-400",
  pending: "bg-zinc-100 text-zinc-500 dark:bg-zinc-800 dark:text-zinc-500",
  "in-progress": "bg-blue-100 text-blue-700 dark:bg-blue-900/50 dark:text-blue-400",
  done: "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/50 dark:text-emerald-400",
  low: "bg-zinc-100 text-zinc-500 dark:bg-zinc-800 dark:text-zinc-500",
  medium: "bg-yellow-100 text-yellow-700 dark:bg-yellow-900/50 dark:text-yellow-400",
  high: "bg-orange-100 text-orange-700 dark:bg-orange-900/50 dark:text-orange-400",
  critical: "bg-red-100 text-red-700 dark:bg-red-900/50 dark:text-red-400",
};

const labels: Record<string, string> = {
  active: "Active",
  archived: "Archived",
  draft: "Draft",
  pending: "Pending",
  "in-progress": "In Progress",
  done: "Done",
  low: "Low",
  medium: "Medium",
  high: "High",
  critical: "Critical",
};

const style = badgeStyles[variant] || badgeStyles.pending;
const label = labels[variant] || variant;
---

<span class:list={["inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium", style]}>
  {label}
</span>