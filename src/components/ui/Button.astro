---
interface Props {
  type?: "button" | "submit" | "reset";
  variant?: "primary" | "secondary" | "danger";
  href?: string;
  class?: string;
}

const { type = "button", variant = "primary", href } = Astro.props;

const colors = {
  primary: "bg-[var(--accent)] text-white hover:opacity-90",
  secondary: "bg-transparent border border-[var(--border)] text-[var(--text)] hover:bg-[var(--hover)]",
  danger: "bg-red-600 text-white hover:bg-red-700",
};

const colorClass = colors[variant];
---

{href ? (
  <a
    {href}
    class:list={["inline-flex items-center justify-center px-4 py-2 rounded font-medium transition-colors", colorClass]}
  >
    <slot />
  </a>
) : (
  <button
    {type}
    class:list={["inline-flex items-center justify-center px-4 py-2 rounded font-medium transition-colors", colorClass]}
  >
    <slot />
  </button>
)}