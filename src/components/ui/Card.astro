---
interface Props {
  href: string;
  class?: string;
}

const { href, class: className } = Astro.props;
---

<a
  {href}
  class:list={[
    "block p-5 rounded-xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-indigo-500 dark:hover:border-indigo-500 hover:-translate-y-1 hover:shadow-xl transition-all duration-200",
    className,
  ]}
>
  <slot />
</a>