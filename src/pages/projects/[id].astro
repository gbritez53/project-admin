---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AppLayout from "../../layouts/AppLayout.astro";
import Badge from "../../components/ui/Badge.astro";
import RequirementList from "../../components/requirements/RequirementList.astro";
import RequirementForm from "../../components/requirements/RequirementForm.astro";
import EmptyState from "../../components/ui/EmptyState.astro";
import { getProjectById } from "../../db/queries/projects";
import { listRequirementsByProject } from "../../db/queries/requirements";

const { id } = Astro.params;

const project = await getProjectById(Astro.locals.db as any, id!);

if (!project) {
  return Astro.redirect("/404");
}

const requirements = await listRequirementsByProject(Astro.locals.db as any, id!);
---

<BaseLayout title={project.name}>
  <AppLayout title={project.name}>
    <div class="max-w-2xl mx-auto px-4 py-6 space-y-6">
      <!-- Header -->
      <div class="flex items-start justify-between">
        <div class="flex-1 min-w-0">
          <a href="/" class="inline-flex items-center text-sm text-zinc-500 dark:text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 mb-3 transition-colors">
            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            Back
          </a>
          <h1 class="text-2xl font-bold text-zinc-900 dark:text-zinc-100">{project.name}</h1>
          {project.description && (
            <p class="text-zinc-500 dark:text-zinc-400 mt-2">{project.description}</p>
          )}
        </div>
        <div class="flex items-center gap-2">
          <Badge variant={project.status} />
          <a 
            href={`/projects/${id}/edit`} 
            class="p-2 rounded-lg text-zinc-500 hover:text-zinc-700 dark:text-zinc-400 dark:hover:text-zinc-200 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 15.232a4.4 4.4 0 01.646-2.606l1.536-1.84a2 2 0 012.908-.818l1.89 1.47a2 2 0 002.242 0l2.624-1.308a4.4 4.4 0 00-.646-2.606l-1.536-1.84a2 2 0 00-2.908-.818l-1.89 1.47a2 2 0 01-2.242 0l-2.624-1.308z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Requirements Section -->
      <section class="space-y-4">
        <div class="flex items-center justify-between">
          <h2 class="text-lg font-semibold text-zinc-900 dark:text-zinc-100">Requirements</h2>
          <span class="text-sm text-zinc-500 dark:text-zinc-400">
            {requirements.length} {requirements.length === 1 ? "item" : "items"}
          </span>
        </div>
        
        <RequirementForm projectId={id} />

        {requirements.length > 0 ? (
          <RequirementList requirements={requirements} />
        ) : (
          <EmptyState message="No requirements yet" />
        )}
      </section>
    </div>
  </AppLayout>
</BaseLayout>