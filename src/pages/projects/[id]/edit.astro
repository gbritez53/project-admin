---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AppLayout from "../../layouts/AppLayout.astro";
import ProjectForm from "../../components/projects/ProjectForm.astro";
import { getProjectById } from "../../db/queries/projects";

const { id } = Astro.params;

const project = await getProjectById(Astro.locals.db as any, id!);

if (!project) {
  return Astro.redirect("/404");
}

const error = Astro.url.searchParams.get("error") || "";
const [errorField, errorMessage] = error.includes(":") 
  ? [error.split(":", 2)[0], decodeURIComponent(error.split(":", 2)[1] || "")]
  : ["", ""];
---

<BaseLayout title={`Edit ${project.name}`}>
  <AppLayout title="Edit Project">
    <div class="max-w-lg mx-auto px-4 py-6">
      <!-- Header -->
      <div class="mb-8">
        <a href={`/projects/${id}`} class="inline-flex items-center text-sm text-zinc-500 dark:text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 mb-4 transition-colors">
          <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          Back to project
        </a>
        <h1 class="text-2xl font-bold text-zinc-900 dark:text-zinc-100">Edit Project</h1>
      </div>
      
      <!-- Error -->
      {error && (
        <div class="mb-6 p-4 rounded-lg bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 flex items-start gap-3">
          <svg class="w-5 h-5 text-red-500 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <div>
            <p class="text-sm font-medium text-red-800 dark:text-red-400">Something went wrong</p>
            <p class="text-sm text-red-600 dark:text-red-500">{errorMessage || error}</p>
          </div>
        </div>
      )}
      
      <!-- Form -->
      <div class="p-6 rounded-xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
        <ProjectForm project={project} action={`/api/projects/${id}`} method="PATCH" />
      </div>
    </div>
  </AppLayout>
</BaseLayout>